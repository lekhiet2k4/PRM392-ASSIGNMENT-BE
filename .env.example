# ============================================================
# Copy file này thành .env rồi điền thông tin vào
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)
# ============================================================

# TiDB Cloud credentials
# Lấy từ: TiDB Cloud Console → Cluster → Connect → MySQL CLI
TIDB_USERNAME=WbnWVMnydCuPte3.root
TIDB_PASSWORD=your_tidb_password_here

# Firebase Service Account
# Đặt file firebase-service-account.json vào src/main/resources/
# Lấy từ: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# Spring profile
SPRING_PROFILES_ACTIVE=dev
