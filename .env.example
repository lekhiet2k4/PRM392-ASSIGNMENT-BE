# ============================================================
# Tạo file src/main/resources/application-local.yml với nội dung:
#
# TIDB_USERNAME: your_tidb_username
# TIDB_PASSWORD: your_tidb_password
#
# File này đã được gitignore, KHÔNG commit lên git
